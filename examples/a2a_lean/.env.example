# examples/a2a_lean — environment template. cp .env.example .env, then edit.
#
# run_server.py loads this file at startup (run_server.py:26).
#
# Uncomment and fill in what you need; leave the rest commented. An empty
# value ("OPENAI_API_KEY=") still registers the name in os.environ, and
# models/model_factory.py checks presence rather than truth, so a blank line
# hides the "key is required" error behind a 401 from the provider.

# --- Required: agent.yaml is provider: openai, model: gpt-4o-mini ---
# OPENAI_API_KEY=          <- uncomment and paste your key

# --- Server bind address (run_server.py defaults) ---
# HOST=127.0.0.1
# PORT=8000

# --- Client target (run_client.py) ---
# AGENT_URL=http://127.0.0.1:8000

# --- Optional ---
# SDK_LOG_LEVEL=DEBUG
