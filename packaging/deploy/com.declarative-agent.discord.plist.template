<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job template for the Discord agent (macOS).

  install.sh fills in the PREFIX, PATH and USER_KEYS placeholders below, then
  installs the result as a LaunchAgent in ~/Library/LaunchAgents (per-user,
  stops at logout) or, with --system, as a LaunchDaemon in
  /Library/LaunchDaemons (starts at boot, survives logout). To do it by hand,
  substitute those tokens yourself and delete the USER_KEYS line entirely
  unless you are installing a daemon, in which case it becomes UserName and
  GroupName keys.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.declarative-agent.discord</string>

    <key>ProgramArguments</key>
    <array>
        <string>@PREFIX@/.venv/bin/declarative-agent</string>
        <string>discord</string>
        <string>--config</string>
        <string>@PREFIX@/agent.yaml</string>
        <string>--log-level</string>
        <string>INFO</string>
    </array>

    <!-- The CLI reads the .env beside the config, so the token never goes in
         this plist — which for a LaunchDaemon is world-readable. -->
    <key>WorkingDirectory</key>
    <string>@PREFIX@</string>

    <!-- SuccessfulExit=false rather than <true/>: restart on any nonzero exit,
         but let a clean SIGTERM shutdown (exit 0) stay down, so `launchctl
         bootout` behaves as a stop instead of fighting launchd. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Minimum seconds between respawns. The default 10 is fast enough to
         hammer Discord's login endpoint when the token is wrong; launchd has no
         equivalent of systemd's start limit, so this throttle is the only brake. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- launchd starts jobs with a near-empty PATH. The agent's exec_command
         and run_script tools shell out, so without this they cannot find
         anything outside /usr/bin. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@PATH@</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- launchd does no rotation; see the README if these grow. -->
    <key>StandardOutPath</key>
    <string>@PREFIX@/logs/discord-agent.log</string>
    <key>StandardErrorPath</key>
    <string>@PREFIX@/logs/discord-agent.err.log</string>
@USER_KEYS@
</dict>
</plist>
